# Copie ce fichier en .env et remplis-le. Le fichier .env ne doit jamais être versionné.

# Nom du club dans l'URL : https://simulatorgolftour.com/club/<SGT_CLUB_URL>
SGT_CLUB_URL=

# Compte administrateur du club (sert à obtenir une clé API valable 24 h)
SGT_USERNAME=
SGT_PASSWORD=

# Optionnel : clé déjà obtenue (sinon elle est demandée avec le compte ci-dessus)
SGT_API_KEY=
