# Secrets
.env

# Données locales (classeurs, exports API : contiennent des noms et e-mails)
data/
*.xlsm
*.xlsx
*.csv
# sauf les handicaps réels (pseudo, catégorie, handicap : ni nom ni e-mail), lus par la mise à jour automatique
!config/joueurs.csv

# Données générées pour le site (régénérées par scripts/export_site_data.py)
site/donnees/

# Réglages locaux de l'éditeur (chemins de cet ordinateur)
.claude/launch.json
.claude/settings.local.json
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/

# Visites du site : écrites en ligne par compteur.php, jamais versionnées
site/visites/
# Empreinte du mot de passe de stats.php : hors Git, envoyée à la main (scripts/deploy_ftps.py)
site/stats-cle.php
