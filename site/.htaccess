# Réglages Apache pour Infomaniak (sans effet si le module n'existe pas)
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  # Les joueurs doivent toujours voir les derniers résultats
  <FilesMatch "saison\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
    # Une zone web de lecteur d'affichage (iframe isolée) lit le fichier comme venant d'un autre site : on l'autorise
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  # Pages et fichiers de la télévision : le lecteur d'affichage vérifie toujours s'il y a une nouvelle version (sinon une ancienne
  # feuille de style peut rester des heures avec un nouveau script)
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Données du compteur de visites (compteur.php) : jamais lisibles depuis le web, seul stats.php les lit sur le serveur
<IfModule mod_alias.c>
  RedirectMatch 404 ^/visites(/|$)
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json text/css application/javascript text/html
</IfModule>
